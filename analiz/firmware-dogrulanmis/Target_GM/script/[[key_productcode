# <- this is for comment / total file size must be less than 4KB

setenv startAddr 0x80200000
saveenv
fatload usb 0 0x80200000 /Target_GM/BIN_FILES/keys/prcode.bin

setenv tmp_cmd 'setenv prcodesize $filesize'
run tmp_cmd
saveenv

writePrKey 6 /Target_GM/BIN_FILES/keys/prcode.bin

% <- this is end of file symbol

