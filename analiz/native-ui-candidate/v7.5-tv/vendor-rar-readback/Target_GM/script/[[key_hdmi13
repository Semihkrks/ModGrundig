#HDMI1 300
setenv startAddr 0x80200000
saveenv
fatload usb 0 0x80200000 /Target_GM/BIN_FILES/keys/hdmi1_300_edid.bin

setenv tmp_cmd 'setenv hdmi13size $filesize'
run tmp_cmd
saveenv

writePrKey 9 /Target_GM/BIN_FILES/keys/hdmi1_300_edid.bin

