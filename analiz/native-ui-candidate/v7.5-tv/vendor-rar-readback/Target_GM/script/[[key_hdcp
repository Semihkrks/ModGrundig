#HDCP
setenv startAddr 0x80200000
saveenv
fatload usb 0 0x80200000 /Target_GM/BIN_FILES/keys/hdcp.bin

setenv tmp_cmd 'setenv hdcpsize $filesize'
run tmp_cmd
saveenv

writePrKey 0 /Target_GM/BIN_FILES/keys/hdcp.bin

