# <- this is for comment / total file size must be less than 4KB

#HDCP
setenv startAddr 0x80200000
saveenv
fatload usb 0 0x80200000 /Target_GM/BIN_FILES/keys/prserial.bin

setenv tmp_cmd 'setenv prserialsize $filesize'
run tmp_cmd
saveenv

writePrKey 5 /Target_GM/BIN_FILES/keys/prserial.bin

% <- this is end of file symbol

