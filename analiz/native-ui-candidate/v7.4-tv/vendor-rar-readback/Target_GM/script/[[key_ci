# <- this is for comment / total file size must be less than 4KB

#HDCP
setenv startAddr 0x80200000
saveenv
fatload usb 0 0x80200000 /Target_GM/BIN_FILES/keys/ci.bin

setenv tmp_cmd 'setenv cisize $filesize'
run tmp_cmd
saveenv

writePrKey 7 /Target_GM/BIN_FILES/keys/ci.bin

