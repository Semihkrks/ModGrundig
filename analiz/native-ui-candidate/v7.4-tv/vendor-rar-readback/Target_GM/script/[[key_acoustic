setenv startAddr 0x80200000
saveenv
fatload usb 0 0x80200000 /Target_GM/BIN_FILES/keys/acoustic.bin

setenv tmp_cmd 'setenv acousticsize $filesize'
run tmp_cmd
saveenv

writePrKey 8 /Target_GM/BIN_FILES/keys/acoustic.bin

