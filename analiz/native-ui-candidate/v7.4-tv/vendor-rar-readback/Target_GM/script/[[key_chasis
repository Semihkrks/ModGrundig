setenv startAddr 0x80200000
saveenv
fatload usb 0 0x80200000 /Target_GM/BIN_FILES/keys/chasis.bin

setenv tmp_cmd 'setenv chasissize $filesize'
run tmp_cmd
saveenv

writePrKey 4 /Target_GM/BIN_FILES/keys/chasis.bin

